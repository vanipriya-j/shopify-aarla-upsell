// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

/// Merchant-configured promotional popup. Shopify owns the real discount.
model Promotion {
  id                        String   @id @default(cuid())
  shop                      String
  name                      String
  enabled                   Boolean  @default(false)
  priority                  Int      @default(0)
  /// FIRST_VISIT | RETURNING_VISITOR | UTM_CAMPAIGN | LANDING_PAGE | PRODUCT_VIEW | PRODUCT_IN_CART | COLLECTION_IN_CART
  audienceType              String
  /// POPUP (V1)
  displayType               String   @default("POPUP")
  headline                  String   @default("")
  message                   String   @default("")
  discountCode              String   @default("")
  ctaText                   String   @default("")
  ctaUrl                    String   @default("")
  popupDelayMs              Int      @default(1200)
  validityHours             Int      @default(24)
  showOnce                  Boolean  @default(false)
  dismissalSuppressionHours Int      @default(24)
  utmSource                 String?
  utmMedium                 String?
  utmCampaign               String?
  utmContent                String?
  landingPath               String?
  minimumCartValue          Float?
  startsAt                  DateTime?
  endsAt                    DateTime?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  targets                   PromotionTarget[]

  @@index([shop, enabled])
  @@index([shop, priority])
  @@index([shop, audienceType])
}

model PromotionTarget {
  id                String    @id @default(cuid())
  promotionId       String
  promotion         Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  /// QUALIFYING_PRODUCT | QUALIFYING_VARIANT | QUALIFYING_COLLECTION | PROMOTED_PRODUCT | PROMOTED_VARIANT | PROMOTED_COLLECTION
  targetType        String
  shopifyResourceId String
  createdAt         DateTime  @default(now())

  @@index([promotionId])
  @@index([promotionId, targetType])
}
