{% comment %}
  Aarla Promotions — Campaign Promotion A settings slot.
  Enable alongside the main Aarla Promotions app embed.
{% endcomment %}

<script
  type="application/json"
  data-aarla-promotions-config
  data-aarla-promotions-source="campaign_a"
>
  {
    "promotions": [
      {
        "key": "campaign_a",
        "enabled": {{ block.settings.enabled | json }},
        "priority": {{ block.settings.priority | json }},
        "utmSource": {{ block.settings.utm_source | json }},
        "utmMedium": {{ block.settings.utm_medium | json }},
        "utmCampaign": {{ block.settings.utm_campaign | json }},
        "utmContent": {{ block.settings.utm_content | json }},
        "landingPagePath": {{ block.settings.landing_page_path | json }},
        "headline": {{ block.settings.headline | json }},
        "message": {{ block.settings.message | json }},
        "discountCode": {{ block.settings.discount_code | json }},
        "ctaText": {{ block.settings.cta_text | json }},
        "ctaDestination": {{ block.settings.cta_destination | json }},
        "validityHours": {{ block.settings.validity_hours | json }},
        "showOnce": {{ block.settings.show_once | json }},
        "dismissalSuppressionHours": {{ block.settings.dismissal_hours | json }}
      }
    ]
  }
</script>

{% schema %}
{
  "name": "Aarla Campaign A",
  "target": "body",
  "settings": [
    {
      "type": "header",
      "content": "Campaign Promotion A"
    },
    {
      "type": "paragraph",
      "content": "Also enable the main Aarla Promotions app embed. Empty UTM fields are ignored."
    },
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enabled",
      "default": false
    },
    {
      "type": "number",
      "id": "priority",
      "label": "Priority",
      "default": 100,
      "info": "Higher numbers win among matching campaigns."
    },
    {
      "type": "text",
      "id": "utm_source",
      "label": "UTM source",
      "default": "meta"
    },
    {
      "type": "text",
      "id": "utm_medium",
      "label": "UTM medium",
      "default": ""
    },
    {
      "type": "text",
      "id": "utm_campaign",
      "label": "UTM campaign",
      "default": "water_bottles"
    },
    {
      "type": "text",
      "id": "utm_content",
      "label": "UTM content",
      "default": ""
    },
    {
      "type": "text",
      "id": "landing_page_path",
      "label": "Optional landing-page path",
      "default": "",
      "info": "Exact path match, e.g. /collections/water-bottles"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "A little something for you"
    },
    {
      "type": "textarea",
      "id": "message",
      "label": "Message",
      "default": "Order within the next 24 hours and enjoy this campaign offer."
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "Discount code",
      "default": "",
      "info": "Leave empty to hide code controls. Create codes in Shopify Admin."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Explore the collection"
    },
    {
      "type": "text",
      "id": "cta_destination",
      "label": "CTA destination",
      "default": "/collections/water-bottles"
    },
    {
      "type": "number",
      "id": "validity_hours",
      "label": "Validity in hours",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "show_once",
      "label": "Show once",
      "default": false
    },
    {
      "type": "number",
      "id": "dismissal_hours",
      "label": "Dismissal suppression in hours",
      "default": 24
    }
  ]
}
{% endschema %}
