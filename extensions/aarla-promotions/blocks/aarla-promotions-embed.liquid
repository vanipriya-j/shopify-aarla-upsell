{% comment %}
  Aarla Promotions — main app embed (global settings + welcome slot).
  Campaign slots are separate embeds due to Shopify's 25-setting block limit.
  Configurable text is exposed via JSON only (never interpolated into JS).
{% endcomment %}

<script
  type="application/json"
  data-aarla-promotions-config
  data-aarla-promotions-source="main"
>
  {
    "global": {
      "enabled": {{ block.settings.enabled | json }},
      "testMode": {{ block.settings.test_mode | json }},
      "testPreview": {{ block.settings.test_preview | json }},
      "popupDelayMs": {{ block.settings.popup_delay_ms | json }},
      "popupPosition": {{ block.settings.popup_position | json }},
      "popupMaxWidth": {{ block.settings.popup_max_width | json }},
      "overlayOpacity": {{ block.settings.overlay_opacity | times: 0.01 | json }},
      "borderRadius": {{ block.settings.border_radius | json }},
      "showReminderBadge": {{ block.settings.show_reminder_badge | json }},
      "debugLogging": {{ block.settings.debug_logging | json }}
    },
    "promotions": [
      {
        "key": "welcome",
        "enabled": {{ block.settings.welcome_enabled | json }},
        "priority": {{ block.settings.welcome_priority | json }},
        "headline": {{ block.settings.welcome_headline | json }},
        "message": {{ block.settings.welcome_message | json }},
        "discountCode": {{ block.settings.welcome_discount_code | json }},
        "ctaText": {{ block.settings.welcome_cta_text | json }},
        "ctaDestination": {{ block.settings.welcome_cta_destination | json }},
        "validityHours": {{ block.settings.welcome_validity_hours | json }},
        "showOnce": {{ block.settings.welcome_show_once | json }},
        "dismissalSuppressionHours": {{ block.settings.welcome_dismissal_hours | json }}
      }
    ],
    "i18n": {
      "close": {{ 'aarla_promotions.close' | t | json }},
      "copy_code": {{ 'aarla_promotions.copy_code' | t | json }},
      "copied": {{ 'aarla_promotions.copied' | t | json }},
      "apply_and_shop": {{ 'aarla_promotions.apply_and_shop' | t | json }},
      "test_mode_label": {{ 'aarla_promotions.test_mode_label' | t | json }},
      "reminder_with_code": {{ 'aarla_promotions.reminder_with_code' | t | json }},
      "reminder_without_code": {{ 'aarla_promotions.reminder_without_code' | t | json }},
      "dismiss_reminder": {{ 'aarla_promotions.dismiss_reminder' | t | json }}
    }
  }
</script>

{% schema %}
{
  "name": "Aarla Promotions",
  "target": "body",
  "stylesheet": "aarla-promotions.css",
  "javascript": "aarla-promotions.js",
  "settings": [
    {
      "type": "header",
      "content": "Global settings"
    },
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable Aarla Promotions",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "test_mode",
      "label": "Test mode",
      "default": false,
      "info": "Preview promotions without changing live visitor localStorage state."
    },
    {
      "type": "select",
      "id": "test_preview",
      "label": "Test mode preview",
      "options": [
        { "value": "automatic", "label": "Automatic" },
        { "value": "welcome", "label": "Welcome Promotion" },
        { "value": "campaign_a", "label": "Campaign Promotion A" },
        { "value": "campaign_b", "label": "Campaign Promotion B" }
      ],
      "default": "automatic"
    },
    {
      "type": "number",
      "id": "popup_delay_ms",
      "label": "Popup delay in milliseconds",
      "default": 1200
    },
    {
      "type": "select",
      "id": "popup_position",
      "label": "Popup position",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "center"
    },
    {
      "type": "number",
      "id": "popup_max_width",
      "label": "Popup maximum width",
      "default": 420
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_reminder_badge",
      "label": "Show reminder badge",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "debug_logging",
      "label": "Debug logging",
      "default": false
    },
    {
      "type": "header",
      "content": "Welcome promotion"
    },
    {
      "type": "checkbox",
      "id": "welcome_enabled",
      "label": "Enabled",
      "default": false
    },
    {
      "type": "number",
      "id": "welcome_priority",
      "label": "Priority",
      "default": 10,
      "info": "Higher numbers win when multiple promotions are eligible."
    },
    {
      "type": "text",
      "id": "welcome_headline",
      "label": "Headline",
      "default": "Welcome to Aarla"
    },
    {
      "type": "textarea",
      "id": "welcome_message",
      "label": "Message",
      "default": "Enjoy 10% off your first order."
    },
    {
      "type": "text",
      "id": "welcome_discount_code",
      "label": "Discount code",
      "default": "AARLA10",
      "info": "Create this discount code in Shopify Admin. This app does not create or validate discounts."
    },
    {
      "type": "text",
      "id": "welcome_cta_text",
      "label": "CTA text",
      "default": "Shop Aarla"
    },
    {
      "type": "text",
      "id": "welcome_cta_destination",
      "label": "CTA destination",
      "default": "/collections/all"
    },
    {
      "type": "number",
      "id": "welcome_validity_hours",
      "label": "Validity in hours",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "welcome_show_once",
      "label": "Show once",
      "default": true
    },
    {
      "type": "number",
      "id": "welcome_dismissal_hours",
      "label": "Dismissal suppression in hours",
      "default": 24
    }
  ]
}
{% endschema %}
